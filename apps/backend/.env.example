NEXUS_PRIMARY.ENV=local

NEXUS_SERVER.PORT=8080
NEXUS_SERVER.READ_TIMEOUT=10
NEXUS_SERVER.WRITE_TIMEOUT=10
NEXUS_SERVER.IDLE_TIMEOUT=60
NEXUS_SERVER.CORS_ALLOWED_ORIGINS=http://localhost:3000

NEXUS_DATABASE.HOST=localhost
NEXUS_DATABASE.PORT=5432
NEXUS_DATABASE.USER=
NEXUS_DATABASE.PASSWORD=
NEXUS_DATABASE.NAME=nexus
NEXUS_DATABASE.SSL_MODE=disable
NEXUS_DATABASE.MAX_OPEN_CONNS=20
NEXUS_DATABASE.MAX_IDLE_CONNS=5
NEXUS_DATABASE.CONN_MAX_LIFETIME=300
NEXUS_DATABASE.CONN_MAX_IDLE_TIME=60

NEXUS_AUTH.SECRET_KEY=
NEXUS_AUTH.WEBHOOK_SECRET=

NEXUS_INTEGRATION.SMTP_HOST=smtp.gmail.com
NEXUS_INTEGRATION.SMTP_PORT=587
NEXUS_INTEGRATION.SMTP_USERNAME=
NEXUS_INTEGRATION.SMTP_PASSWORD=
NEXUS_INTEGRATION.SMTP_FROM=

NEXUS_REDIS.ADDRESS=localhost:6379

NEXUS_OBSERVABILITY.SERVICE_NAME=nexus
NEXUS_OBSERVABILITY.ENVIRONMENT=development
NEXUS_OBSERVABILITY.LOGGING.LEVEL=debug
NEXUS_OBSERVABILITY.LOGGING.FORMAT=console
NEXUS_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD=100ms
NEXUS_OBSERVABILITY.NEW_RELIC.LICENSE_KEY=
NEXUS_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED=true
NEXUS_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED=true
NEXUS_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING=false
NEXUS_OBSERVABILITY.HEALTH_CHECKS.ENABLED=true
NEXUS_OBSERVABILITY.HEALTH_CHECKS.INTERVAL=30s
NEXUS_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT=5s
NEXUS_OBSERVABILITY.HEALTH_CHECKS.CHECKS=database,redis

# S3-compatible object storage (e.g. Cloudflare R2) for chat attachments.
# Optional -- uploads are disabled gracefully if left empty.
NEXUS_AWS.REGION=
NEXUS_AWS.ACCESS_KEY_ID=
NEXUS_AWS.SECRET_ACCESS_KEY=
NEXUS_AWS.ENDPOINT_URL=
NEXUS_AWS.UPLOAD_BUCKET=

# OpenSearch/Elasticsearch for post/people/community search. Optional --
# search is disabled gracefully if left empty.
NEXUS_SEARCH.URL=
NEXUS_SEARCH.USERNAME=
NEXUS_SEARCH.PASSWORD=
