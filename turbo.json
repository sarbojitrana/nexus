{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "tasks": {
      "build": {
        "dependsOn": ["^build"],
        "inputs": ["$TURBO_DEFAULT$", ".env*"],
        "env": [
          "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
          "CLERK_SECRET_KEY",
          "NEXT_PUBLIC_API_URL"
        ]
      },
      "lint": {
        "dependsOn": ["^lint"]
      },
      "lint:fix": {
        "dependsOn": ["^lint:fix"]
      },
      "format": {
        "dependsOn": ["^format"]
      },
      "format:fix": {
        "dependsOn": ["^format:fix"]
      },
      "typecheck": {
        "dependsOn": ["^typecheck"]
      },
      "clean": {
        "cache": false
      },
      "dev": {
        "cache": false,
        "persistent": true
      }
    }
  }
  